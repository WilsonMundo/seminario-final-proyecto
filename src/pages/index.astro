---
import "../styles/app.css";
---

<!doctype html>
<html lang="es" data-theme="corporate" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>
      Asistente Inteligente con Arquitectura Agéntica — Wilson Neftali Mundo Alonzo (UMG)
    </title>
  </head>
  <body class="bg-base-200 text-base-content antialiased selection:bg-primary/20">
    <!-- Barra Superior Flotante (Oculta al imprimir) -->
    <header
      class="no-print sticky top-0 z-50 border-b border-base-300 bg-base-100/95 backdrop-blur supports-[backdrop-filter]:bg-base-100/80 shadow-xs"
    >
      <div class="navbar max-w-6xl mx-auto px-4 min-h-14">
        <div class="navbar-start gap-3">
          <img src="/Logo.png" alt="Logo UMG" class="w-8 h-8 object-contain" />
          <div class="leading-tight">
            <span class="font-bold text-sm tracking-tight block text-slate-900">
              Informe Final de Graduación
            </span>
            <span class="text-xs text-slate-500 block">
              Universidad Mariano Gálvez de Guatemala
            </span>
          </div>
        </div>

        <nav class="navbar-center hidden md:flex">
          <ul class="menu menu-horizontal px-1 text-xs font-medium gap-1">
            <li><a href="#portada" class="rounded-md">Portada</a></li>
            <li><a href="#problema-solucion" class="rounded-md">0. Problema y Solución</a></li>
            <li><a href="#aspectos-eticos" class="rounded-md">1. Ética</a></li>
            <li><a href="#aspecto-legal" class="rounded-md">2. Legal</a></li>
            <li><a href="#seguridad-informatica" class="rounded-md">3. Seguridad</a></li>
            <li><a href="#caso-uso-real" class="rounded-md">4. Caso de Uso</a></li>
            <li><a href="#despliegue-kubernetes" class="rounded-md">5. Kubernetes</a></li>
            <li><a href="#conclusiones-recomendaciones" class="rounded-md">6. Conclusiones</a></li>
          </ul>
        </nav>

        <div class="navbar-end gap-2">
          <button
            type="button"
            onclick="window.print()"
            class="btn btn-primary btn-sm gap-2 font-semibold shadow-xs"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
              />
            </svg>
            Exportar a PDF
          </button>
        </div>
      </div>
    </header>

    <!-- Contenedor Principal tipo Hoja Carta -->
    <main class="max-w-[21.59cm] mx-auto my-6 px-4 sm:px-0 print:my-0 print:px-0">
      <!-- ================================================================= -->
      <!-- PORTADA ACADÉMICA OFICIAL (UNIVERSIDAD MARIANO GÁLVEZ)            -->
      <!-- ================================================================= -->
      <section
        id="portada"
        class="page-break relative bg-white text-[#0f172a] shadow-md border border-slate-200/80 rounded-xs px-10 py-14 sm:px-16 sm:py-16 min-h-[27.94cm] flex flex-col justify-between items-center text-center select-text print:shadow-none print:border-0 print:p-0 print:min-h-[24.9cm]"
      >
        <!-- Encabezado Institucional -->
        <div class="z-10 w-full space-y-5 pt-2 font-serif tracking-wide">
          <h1 class="text-lg sm:text-[19px] font-bold uppercase text-black leading-snug">
            UNIVERSIDAD MARIANO GÁLVEZ DE GUATEMALA
          </h1>
          <h2 class="text-base sm:text-[17px] font-bold uppercase text-black leading-snug">
            FACULTAD DE INGENIERÍA
          </h2>
          <h3 class="text-sm sm:text-[15.5px] font-bold uppercase text-black leading-snug max-w-2xl mx-auto">
            INGENIERÍA EN SISTEMAS DE LA INFORMACIÓN Y CIENCIAS DE LA COMPUTACIÓN
          </h3>
        </div>

        <!-- Bloque Central con Marca de Agua UMG y Título de Tesis -->
        <div class="relative flex items-center justify-center w-full my-auto py-16">
          <!-- Escudo UMG en marca de agua central -->
          <img
            src="/Logo.png"
            alt="Escudo Universidad Mariano Gálvez de Guatemala"
            class="pointer-events-none select-none w-[320px] sm:w-[370px] h-[320px] sm:h-[370px] object-contain opacity-22"
          />

          <!-- Título del Proyecto Superpuesto al Centro -->
          <div class="absolute inset-0 flex items-center justify-center px-2 sm:px-6">
            <h2
              class="font-serif text-base sm:text-[17.5px] font-bold uppercase text-black leading-[2.1] tracking-wide max-w-[640px]"
            >
              ASISTENTE INTELIGENTE CON ARQUITECTURA AGÉNTICA PARA LA
              CONSULTA Y GESTIÓN ASISTIDA DE INFORMACIÓN EMPRESARIAL MEDIANTE
              LENGUAJE NATURAL EN UN SOFTWARE DE ADMINISTRACIÓN EMPRESARIAL
            </h2>
          </div>
        </div>

        <!-- Pie de Portada: Autor y Fecha -->
        <div class="z-10 w-full space-y-5 pb-4 font-serif text-black">
          <p class="text-base sm:text-[17px] font-normal tracking-normal">
            Wilson Neftali Mundo Alonzo
          </p>
          <p class="text-base sm:text-[17px] font-normal tracking-normal">
            Guatemala, noviembre de 2026
          </p>
        </div>
      </section>

      <!-- ================================================================= -->
      <!-- ESPACIO RESERVADO PARA LOS SIGUIENTES BLOQUES DEL DOCUMENTO       -->
      <!-- ================================================================= -->
      <div id="contenido-documento" class="space-y-8 mt-8 print:mt-0">
        <!-- =============================================================== -->
        <!-- SECCIÓN PRELIMINAR (RÚBRICA 35% + CANDADO 60%):                  -->
        <!-- EL PROBLEMA, LA SOLUCIÓN IMPLEMENTADA Y BACKEND CON BD EN NUBE  -->
        <!-- =============================================================== -->
        <section
          id="problema-solucion"
          class="page-break bg-white text-[#0f172a] shadow-md border border-slate-200/80 rounded-xs px-8 py-10 sm:px-12 sm:py-12 space-y-6 print:shadow-none print:border-0 print:p-0"
        >
          <!-- Encabezado de Sección -->
          <div class="border-b-2 border-slate-800 pb-3 flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="badge badge-primary badge-sm font-semibold uppercase tracking-wider mb-1">
                Propósito Central · Planteamiento, Solución y Backend Cloud
              </span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                El Problema Empresarial, la Solución Implementada y Arquitectura Backend Cloud
              </h2>
            </div>
            <span class="text-xs font-mono text-slate-500">
              Repo: github.com/WilsonMundo/seminario-final-proyecto
            </span>
          </div>

          <!-- Introducción del Propósito Central -->
          <p class="text-sm leading-relaxed text-slate-700 text-justify">
            Más allá del desarrollo de componentes de software o de la orquestación de contenedores, el
            propósito central de este proyecto de graduación consiste en resolver de forma verificable un
            cuello de botella operativo y económico real dentro de una <strong>empresa comercial en Guatemala</strong>
            cuya operación diaria descansa sobre cuatro módulos transaccionales críticos de un sistema de
            planificación de recursos empresariales (ERP): <strong>Inventarios, Compras, Ventas y Cuentas por Cobrar</strong>.
            A continuación se documenta la raíz del problema identificada en el Capítulo I del informe final,
            la coherencia práctica de la arquitectura de tres capas construida y la certificación técnica del
            almacenamiento de usuarios y artefactos en bases de datos con servicios en la nube.
          </p>

          <!-- KPIs de Contraste Problema vs. Solución -->
          <div class="stats grid grid-cols-2 sm:grid-cols-4 w-full bg-slate-50 border border-slate-300 rounded-md shadow-none overflow-visible">
            <div class="stat py-3 px-3.5 border-b sm:border-b-0 sm:border-r border-slate-200">
              <div class="stat-title text-[11px] font-semibold text-slate-600 whitespace-normal leading-tight">
                Espera Tradicional vs. Asistida
              </div>
              <div class="stat-value text-lg sm:text-xl font-extrabold text-primary my-0.5">
                72 h → 11.04 s
              </div>
              <div class="stat-desc text-[10.5px] text-slate-600 whitespace-normal leading-snug">
                De 1–3 días hábiles manuales a mediana P50 en vivo
              </div>
            </div>

            <div class="stat py-3 px-3.5 border-b sm:border-b-0 sm:border-r border-slate-200">
              <div class="stat-title text-[11px] font-semibold text-slate-600 whitespace-normal leading-tight">
                Costo de 5 Reportes Complejos
              </div>
              <div class="stat-value text-lg sm:text-xl font-extrabold text-emerald-700 my-0.5">
                -95.79 %
              </div>
              <div class="stat-desc text-[10.5px] text-slate-600 whitespace-normal leading-snug">
                De USD 625.00 (manual) a USD 26.31 (asistido)
              </div>
            </div>

            <div class="stat py-3 px-3.5 border-r border-slate-200">
              <div class="stat-title text-[11px] font-semibold text-slate-600 whitespace-normal leading-tight">
                Persistencia de Usuarios Cloud
              </div>
              <div class="stat-value text-lg sm:text-xl font-extrabold text-slate-900 my-0.5">
                SQL + PG Cloud
              </div>
              <div class="stat-desc text-[10.5px] text-slate-600 whitespace-normal leading-snug">
                100 % usuarios, 2FA y RBAC en BD Cloud VPS
              </div>
            </div>

            <div class="stat py-3 px-3.5">
              <div class="stat-title text-[11px] font-semibold text-slate-600 whitespace-normal leading-tight">
                Re-Query de Reportes Guardados
              </div>
              <div class="stat-value text-lg sm:text-xl font-extrabold text-slate-900 my-0.5">
                USD 0.00 IA
              </div>
              <div class="stat-desc text-[10.5px] text-slate-600 whitespace-normal leading-snug">
                Re-ejecución directa en ApiHub sin llamar al LLM
              </div>
            </div>
          </div>

          <!-- 0.1 Comprensión a Fondo de la Raíz del Problema -->
          <div class="space-y-4">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 border-l-4 border-primary pl-3">
              Comprensión a Fondo de la Raíz del Problema (Sección 1.4 y 3.1.2)
            </h3>
            <p class="text-sm leading-relaxed text-slate-700 text-justify">
              El diagnóstico realizado sobre la empresa comercial evidenció que el problema de fondo <strong>no era la ausencia de datos</strong>,
              sino la <strong>fricción estructural entre el lenguaje de negocio y el modelo relacional normalizado del ERP</strong>.
              Mientras los usuarios de gerencia, ventas, compras y créditos formulan necesidades en términos comerciales
              (<em>«¿cuáles fueron los productos más comprados en el último trimestre frente a sus unidades vendidas?»</em> o
              <em>«¿cuál es el balance de antigüedad de saldos por cliente a octubre?»</em>), el ERP almacena los hechos
              distribuidos en decenas de tablas maestras, encabezados, detalles de documentos y movimientos de kardex.
              Cuando una necesidad analítica supera las pantallas predefinidas o cruza varios módulos, la organización
              quedaba atrapada en un <strong>procedimiento tradicional manual de tres etapas</strong>:
            </p>

            <!-- Las 3 etapas del problema tradicional vs por qué no usar un LLM sin gobierno -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
              <div class="card bg-white border border-slate-300 shadow-2xs rounded-md">
                <div class="card-body p-4 space-y-1.5">
                  <div class="flex items-center justify-between">
                    <span class="badge badge-outline badge-xs font-mono border-slate-400 text-slate-700">
                      Etapa Manual 1
                    </span>
                    <span class="text-[11px] font-mono font-bold text-amber-800">Cuello Operativo</span>
                  </div>
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900">
                    1. Identificación y Solicitud Informal
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed text-justify">
                    El usuario de negocio detecta que el reporte requerido no existe en las opciones fijas del ERP
                    o exige navegar por múltiples pantallas y exportar archivos parciales para consolidarlos
                    manualmente en hojas de cálculo (Excel), con alto riesgo de error humano y discrepancia de cifras.
                  </p>
                </div>
              </div>

              <div class="card bg-white border border-slate-300 shadow-2xs rounded-md">
                <div class="card-body p-4 space-y-1.5">
                  <div class="flex items-center justify-between">
                    <span class="badge badge-outline badge-xs font-mono border-slate-400 text-slate-700">
                      Etapa Manual 2
                    </span>
                    <span class="text-[11px] font-mono font-bold text-red-700">Dependencia TI</span>
                  </div>
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900">
                    2. Resolución Técnica Manual en SQL
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed text-justify">
                    El requerimiento se escala a soporte técnico o al administrador de base de datos, quien debe
                    interpretar la necesidad, localizar tablas y llaves foráneas en SQL Server, programar la consulta
                    <code class="font-mono text-[11px]">T-SQL</code> o desarrollar una vista/reporte nuevo dentro del
                    ERP a un costo promedio de <strong>USD 125.00 por reporte</strong>.
                  </p>
                </div>
              </div>

              <div class="card bg-white border border-slate-300 shadow-2xs rounded-md">
                <div class="card-body p-4 space-y-1.5">
                  <div class="flex items-center justify-between">
                    <span class="badge badge-outline badge-xs font-mono border-slate-400 text-slate-700">
                      Etapa Manual 3
                    </span>
                    <span class="text-[11px] font-mono font-bold text-red-700">24 a 72 Horas</span>
                  </div>
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900">
                    3. Validación Tardía y Pérdida de Oportunidad
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed text-justify">
                    La entrega demora entre <strong>1 y 3 días hábiles</strong> según la carga del equipo técnico.
                    Si al recibir los datos la gerencia necesita cambiar un filtro, agregar el costo promedio o
                    comparar otro período, el ciclo vuelve a iniciar, degradando la oportunidad en la toma de decisiones.
                  </p>
                </div>
              </div>
            </div>

            <!-- Formulación Académica del Problema, Objetivo e Hipótesis (Secciones 1.5 a 1.7) -->
            <div class="bg-slate-50 border border-slate-300 rounded-md p-4 space-y-2.5">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-800">
                Alineación Metodológica del Planteamiento (Secciones 1.5, 1.6 y 1.7 del Informe de Tesis)
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-slate-700">
                <div class="bg-white border border-slate-200 rounded p-3 space-y-1">
                  <span class="font-bold text-slate-900 block">Pregunta Principal (Secc. 1.5.1):</span>
                  <p class="leading-relaxed text-justify">
                    ¿En qué medida la implementación de un asistente inteligente con arquitectura agéntica permite
                    consultar y gestionar información empresarial mediante lenguaje natural de forma precisa, segura y
                    oportuna en los módulos de <strong>Inventarios, Compras, Ventas y Cuentas por Cobrar</strong>,
                    reduciendo además el costo asociado al desarrollo de nuevos reportes frente al procedimiento
                    tradicional del ERP?
                  </p>
                </div>
                <div class="bg-white border border-slate-200 rounded p-3 space-y-1">
                  <span class="font-bold text-slate-900 block">Objetivo General (Secc. 1.6.1):</span>
                  <p class="leading-relaxed text-justify">
                    Desarrollar y evaluar un asistente inteligente con arquitectura agéntica para la consulta y gestión
                    asistida de información empresarial mediante lenguaje natural en un ERP, determinando su efecto en
                    la eficiencia en la obtención de información, la precisión de respuesta y el costo de generación de
                    nuevos reportes de alta complejidad frente al procedimiento tradicional.
                  </p>
                </div>
                <div class="bg-white border border-slate-200 rounded p-3 space-y-1">
                  <span class="font-bold text-slate-900 block">Hipótesis de Investigación H₁ (Secc. 1.7):</span>
                  <p class="leading-relaxed text-justify">
                    La implementación del asistente inteligente mejora significativamente la eficiencia en la obtención
                    de información empresarial y reduce en <strong>al menos un 20 %</strong> el costo asociado a la
                    generación de cinco reportes de alta complejidad (resultado real demostrado: <strong>-95.79 %</strong>,
                    pasando de USD 625.00 a USD 26.31).
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 0.2 Utilidad Práctica de la Aplicación: Solución Directa y Coherente -->
          <div class="space-y-4">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 border-l-4 border-primary pl-3">
              Utilidad de la Aplicación: Solución Práctica sin Complejidad Innecesaria (Secciones 3.7 y 4.1–4.6)
            </h3>
            <p class="text-sm leading-relaxed text-slate-700 text-justify">
              Para resolver la problemática sin incurrir en el riesgo de conectar un LLM de forma directa e irrestricta
              a la base de datos corporativa —lo cual habría expuesto credenciales, provocado alucinaciones de tablas
              inexistentes y consumido ~35 KB de esquema por cada pregunta—, se diseñó una <strong>arquitectura empresarial
              desacoplada de tres capas</strong> que se integra al ERP existente sin reemplazar sus pantallas transaccionales.
              Cada componente cumple una responsabilidad estrictamente acotada que prioriza el valor práctico:
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="card bg-slate-50 border border-slate-300 shadow-none rounded-md">
                <div class="card-body p-4 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="badge badge-primary badge-xs font-semibold uppercase">
                      Orquestación Cognitiva Bifurcada
                    </span>
                    <span class="text-xs font-mono text-slate-500">Luna + Terra + Milvus</span>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900">
                    1. Traducción Semántica con Contexto Mínimo (~3.5 KB)
                  </h4>
                  <p class="text-xs text-slate-700 leading-relaxed text-justify">
                    El microservicio <code class="font-mono text-[11px] bg-white px-1 py-0.5 rounded border border-slate-200">rag-api (Python / FastAPI / LangGraph)</code>
                    divide el trabajo en dos perfiles: <strong>Agente Luna</strong> (<code class="font-mono text-[11px]">gpt-5.6-luna</code>)
                    clasifica la intención en 8 categorías cerradas, solicita aclaración si faltan parámetros y redacta la
                    síntesis final; mientras que <strong>Agente Terra</strong> (<code class="font-mono text-[11px]">gpt-5.6-terra</code>)
                    recupera evidencia semántica en <strong>Milvus</strong> (índice <code class="font-mono text-[11px]">AUTOINDEX / COSINE</code>,
                    1,536 dimensiones) y utiliza el <code class="font-mono text-[11px]">SchemaClosureEngine</code> para
                    recortar el esquema de ~35 KB a ~3.5 KB antes de proponer un contrato <code class="font-mono text-[11px]">QueryPlanCandidateV1</code>.
                  </p>
                </div>
              </div>

              <div class="card bg-slate-50 border border-slate-300 shadow-none rounded-md">
                <div class="card-body p-4 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="badge badge-neutral badge-xs font-semibold uppercase">
                      Valor Práctico y Reutilización
                    </span>
                    <span class="text-xs font-mono text-slate-500">QueryArtifactRecord · Re-Query</span>
                  </div>
                  <h4 class="font-bold text-sm text-slate-900">
                    2. Hidratación Directa y Re-Query a Costo Cero de IA
                  </h4>
                  <p class="text-xs text-slate-700 leading-relaxed text-justify">
                    Cuando <code class="font-mono text-[11px] bg-white px-1 py-0.5 rounded border border-slate-200">ApiHub (.NET)</code>
                    valida y ejecuta el <code class="font-mono text-[11px]">SELECT</code> en SQL Server, hidrata hasta
                    <strong>700 filas</strong> directamente hacia la interfaz <code class="font-mono text-[11px]">Angular 22 + DevExtreme</code>
                    (con exportación inmediata a Excel/PDF y gráficos <code class="font-mono text-[11px]">DxChart</code>)
                    y envía al LLM únicamente evidencia acotada si el resultado no supera las <strong>200 filas</strong>.
                    Además, los reportes validados se guardan en <code class="font-mono text-[11px]">assistant.query_artifacts</code>,
                    permitiendo que los usuarios los re-ejecuten cambiando fechas o límites <strong>sin volver a invocar a OpenAI</strong>.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 0.3 Candado del 60 % de la Rúbrica: Usuarios y Backend en Base de Datos en la Nube -->
          <div class="space-y-3">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 border-l-4 border-emerald-700 pl-3">
              Certificación de Backend y Usuarios Almacenados en Base de Datos en la Nube (Requisito Excluyente 60 %)
            </h3>
            <p class="text-sm leading-relaxed text-slate-700 text-justify">
              En cumplimiento estricto del requisito obligatorio de la convocatoria (<em>«Todos los usuarios de su
              aplicación deben estar almacenados en una base de datos con servicios en la nube, es decir que debe
              tener backend»</em>), el sistema <strong>no utiliza usuarios estáticos en memoria ni almacenamiento local en el navegador</strong>.
              La totalidad del ciclo de identidad, doble factor de autenticación (<strong>2FA / MFA</strong>), roles
              corporativos, bitácoras de auditoría y artefactos de consulta opera sobre motores de bases de datos
              relacionales desplegados en el servidor cloud VPS de producción (<code class="font-mono text-xs bg-slate-100 px-1 py-0.5 rounded">https://agente.mundoalonzo.com</code>)
              y gobernados por el backend empresarial <code class="font-mono text-xs bg-slate-100 px-1 py-0.5 rounded">ApiHub (C# / .NET 8)</code>
              en <strong>Kubernetes (K3s)</strong>:
            </p>

            <div class="overflow-x-auto border border-slate-300 rounded-md">
              <table class="table table-xs sm:table-sm w-full text-left border-collapse">
                <thead>
                  <tr class="bg-slate-100 text-slate-800 border-b border-slate-300 text-[11px] uppercase tracking-wider">
                    <th class="py-2.5 px-3 font-bold">Capa / Entidad Persistida en la Nube</th>
                    <th class="py-2.5 px-3 font-bold">Motor de Base de Datos Cloud y Red</th>
                    <th class="py-2.5 px-3 font-bold">Servicio Backend Propietario</th>
                    <th class="py-2.5 px-3 font-bold">Evidencia Funcional y Reglas Aplicadas</th>
                  </tr>
